{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Blueprint Runtime Registry",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "source",
    "tasks",
    "phases",
    "task_dag"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "generated_at": {
      "type": "string"
    },
    "source": {
      "type": "object"
    },
    "project": {
      "type": "object"
    },
    "stack": {
      "type": "object"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema_version",
          "id",
          "task_id",
          "title",
          "description",
          "dependency_rationale",
          "phase_id",
          "step_id",
          "order",
          "type",
          "status",
          "depends_on",
          "dependents",
          "implements",
          "builds",
          "closes_journeys",
          "journey_refs",
          "arc42_refs",
          "write_set",
          "read_set",
          "conflict_group",
          "conflict_groups",
          "building_block_refs",
          "verification_refs",
          "risk",
          "risk_level",
          "verify_mode",
          "verification_surface",
          "acceptance",
          "evidence_contract",
          "contract_refs",
          "source_refs",
          "resolved_specs",
          "generated_from",
          "depends_on_rationale",
          "dependency_edges",
          "resolved_dependencies",
          "locks",
          "parallel"
        ],
        "properties": {
          "schema_version": {
            "const": "2.0"
          },
          "id": {
            "type": "string",
            "pattern": "^SLICE-"
          },
          "task_id": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 4
          },
          "description": {
            "type": "string",
            "minLength": 240
          },
          "phase_id": {
            "type": "string"
          },
          "step_id": {
            "type": "string"
          },
          "order": {
            "type": "integer"
          },
          "type": {
            "type": "string"
          },
          "status": {
            "enum": [
              "todo",
              "ready",
              "claimed",
              "in_progress",
              "validator_tester_pending",
              "needs_debug",
              "ready_for_close",
              "verified_pending_close",
              "blocked",
              "done",
              "superseded",
              "waived"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependents": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "implements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "builds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "closes_journeys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "journey_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "write_set": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "read_set": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "conflict_group": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "conflict_groups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "building_block_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verification_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "risk": {
            "type": "string"
          },
          "risk_level": {
            "type": "string"
          },
          "verify_mode": {
            "type": "string"
          },
          "acceptance": {
            "type": [
              "array",
              "object"
            ]
          },
          "evidence_contract": {
            "type": [
              "object",
              "array"
            ]
          },
          "contract_refs": {
            "type": "object"
          },
          "source_refs": {
            "type": "array"
          },
          "generated_from": {
            "type": "object"
          },
          "created_at": {
            "type": "string"
          },
          "dependency_rationale": {
            "type": "string",
            "minLength": 180
          },
          "resolved_specs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "kind",
                "description",
                "details",
                "source_ref",
                "raw"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "description": {
                  "type": "string",
                  "minLength": 80
                },
                "details": {
                  "type": "object"
                },
                "source_ref": {
                  "type": "object"
                },
                "raw": {
                  "type": "object"
                }
              }
            }
          },
          "depends_on_rationale": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "dependency_edges": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "from",
                "to",
                "reason"
              ],
              "properties": {
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              }
            }
          },
          "resolved_dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "title",
                "description",
                "dependency_rationale",
                "phase_id"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "dependency_rationale": {
                  "type": "string"
                },
                "phase_id": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "implements": {
                  "type": "array"
                },
                "builds": {
                  "type": "array"
                },
                "verification_refs": {
                  "type": "array"
                }
              }
            }
          },
          "arc42_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "locks": {
            "type": "object",
            "required": [
              "task",
              "write_set",
              "conflict_groups",
              "lock_files"
            ],
            "properties": {
              "task": {
                "type": "string"
              },
              "write_set": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "conflict_groups": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "lock_files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "parallel": {
            "type": "object",
            "required": [
              "eligible",
              "safe_group",
              "conflict_checked"
            ],
            "properties": {
              "eligible": {
                "type": "boolean"
              },
              "safe_group": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "conflict_checked": {
                "type": "boolean"
              }
            }
          },
          "verification_surface": {
            "type": "object",
            "required": [
              "kind",
              "method",
              "requires_visual_mcp",
              "requires_screen_journey_reviewer",
              "journey_refs_are_ui_signals",
              "rationale"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "method": {
                "type": "string"
              },
              "requires_visual_mcp": {
                "type": "boolean"
              },
              "requires_screen_journey_reviewer": {
                "type": "boolean"
              },
              "journey_refs_are_ui_signals": {
                "type": "boolean"
              },
              "journey_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "ui_spec_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "route_refs": {
                "type": "array"
              },
              "rationale": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    "phases": {
      "type": "array"
    },
    "task_dag": {
      "type": "object"
    },
    "journeys": {
      "type": "array"
    }
  }
}
